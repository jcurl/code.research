ARG CODE_VERSION=10.1
ARG UBUNTU_VERSION=noble
FROM ubuntu:${UBUNTU_VERSION}
LABEL MAINTAINER="Jason Curl <jcurl@arcor.de>"

ARG CODE_VERSION
ARG NETBSD_VERSION=${CODE_VERSION}

# We need to make the install non-interactive, so that we don't get asked for
# tzdata. We don't need DEBIAN_FRONTEND after the build, so we don't make it an
# explicit variable.
ARG DEBIAN_FRONTEND=noninteractive

# And if we happen to build an unsupported release that doesn't receive updates
# anymore, just update the apt sources and continue.
RUN (apt update -y || \
      sed -i -re 's/([a-z]{2}\.)?archive.ubuntu.com|security.ubuntu.com/old-releases.ubuntu.com/g' /etc/apt/sources.list \
      && apt update -y) \
    && apt install -y --no-install-recommends \
      less \
      python3 python3-requests python3-zstandard python3-cryptography \
      build-essential zlib1g-dev wget pigz \
      lsb-release cmake git-core \
      clang clang-tidy clang-format lld \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pkgdownload pkgdownload.py /opt/pkg/
ARG SRCBASE=/opt/netbsd/${NETBSD_VERSION}/src
RUN mkdir -p $SRCBASE
WORKDIR $SRCBASE

# We use a local mirror, as projects frequently move to archives
#RUN wget --no-check-certificate -r -l 1 -np -nd -nc -nv -A "*.tgz" https://cdn.netbsd.org/pub/NetBSD/NetBSD-${NETBSD_VERSION}/source/sets
RUN wget --no-check-certificate -r -l 1 -np -nd -nc -nv -A "*.tgz" https://www.home.lan/xbsd/netbsd/releases/NetBSD-${NETBSD_VERSION}/source/sets
RUN for file in *.tgz; do echo Extracting $file...; tar --no-same-owner --no-same-permissions -xzf $file; done

# When we download, we ignore the CA with `--ignore-ca`. That is because our
# mirror is self-signed.

ARG BASE=/opt/netbsd/${NETBSD_VERSION}/aarch64
RUN NPROC=`nproc` && cd $SRCBASE/usr/src \
  && DESTDIR=$BASE/sysroot ./build.sh -O $BASE/build -T $BASE/tools -j$NPROC -m evbarm -a aarch64 tools libs
RUN cd $BASE && tar -cf - build | pigz -9 > build.tar.gz
RUN /opt/pkg/pkgdownload.py --ignore-ca --os netbsd --version ${NETBSD_VERSION} --arch aarch64 --sysroot ${BASE}/sysroot/usr libxml2

ARG BASE=/opt/netbsd/${NETBSD_VERSION}/aarch64eb
RUN NPROC=`nproc` && cd $SRCBASE/usr/src \
  && DESTDIR=$BASE/sysroot ./build.sh -O $BASE/build -T $BASE/tools -j$NPROC -m evbarm -a aarch64eb tools libs
RUN cd $BASE && tar -cf - build | pigz -9 > build.tar.gz
RUN /opt/pkg/pkgdownload.py --ignore-ca --os netbsd --version ${NETBSD_VERSION} --arch aarch64eb --sysroot ${BASE}/sysroot/usr libxml2

ARG BASE=/opt/netbsd/${NETBSD_VERSION}/amd64
RUN NPROC=`nproc` && cd $SRCBASE/usr/src \
  && DESTDIR=$BASE/sysroot ./build.sh -O $BASE/build -T $BASE/tools -j$NPROC -m amd64 -a x86_64 tools libs
RUN cd $BASE && tar -cf - build | pigz -9 > build.tar.gz
RUN /opt/pkg/pkgdownload.py --ignore-ca --os netbsd --version ${NETBSD_VERSION} --arch amd64 --sysroot ${BASE}/sysroot/usr libxml2

ARG BASE=/opt/netbsd/${NETBSD_VERSION}/i386
RUN NPROC=`nproc` && cd $SRCBASE/usr/src \
  && DESTDIR=$BASE/sysroot ./build.sh -O $BASE/build -T $BASE/tools -j$NPROC -m i386 -a i386 tools libs
RUN cd $BASE && tar -cf - build | pigz -9 > build.tar.gz
RUN /opt/pkg/pkgdownload.py --ignore-ca --os netbsd --version ${NETBSD_VERSION} --arch i386 --sysroot ${BASE}/sysroot/usr libxml2

RUN rm -rf /opt/netbsd/${NETBSD_VERSION}/aarch64/build \
  && rm -rf /opt/netbsd/${NETBSD_VERSION}/aarch64eb/build \
  && rm -rf /opt/netbsd/${NETBSD_VERSION}/amd64/build \
  && rm -rf /opt/netbsd/${NETBSD_VERSION}/i386/build \
  && rm -rf /opt/netbsd/${NETBSD_VERSION}/src/usr

RUN mkdir -p /source && mkdir -p /build
WORKDIR /build
CMD [ "bash" ]
