ARG CODE_VERSION=0.0
ARG UBUNTU_VERSION=noble
FROM ubuntu:${UBUNTU_VERSION}
LABEL MAINTAINER="Jason Curl <jcurl@arcor.de>"

ARG CODE_VERSION
ARG FREEBSD_VERSION=${CODE_VERSION}

# We need to make the install non-interactive, so that we don't get asked for
# tzdata. We don't need DEBIAN_FRONTEND after the build, so we don't make it an
# explicit variable.
ARG DEBIAN_FRONTEND=noninteractive

# And if we happen to build an unsupported release that doesn't receive updates
# anymore, just update the apt sources and continue.
RUN (apt update -y || \
      sed -i -re 's/([a-z]{2}\.)?archive.ubuntu.com|security.ubuntu.com/old-releases.ubuntu.com/g' /etc/apt/sources.list \
      && apt update -y) \
    && apt install -y --no-install-recommends \
      less \
      python3 python3-requests python3-zstandard python3-cryptography \
      build-essential zlib1g-dev pigz \
      lsb-release cmake git-core \
      clang clang-tidy clang-format lld \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ARG SYSROOT=/opt/freebsd/${FREEBSD_VERSION}/aarch64/sysroot

# Named build context "pkgdownload" is provided by build.sh
# (qnx/scripts/freebsd/pkg). The script downloads the FreeBSD image, and then
# installs the packages in the sysroot.
COPY --from=pkgdownload pkgdownload.py /opt/pkg/
RUN mkdir -p /opt/freebsd/src
WORKDIR /opt/freebsd/src
RUN /opt/pkg/pkgdownload.py --ignore-ca --os freebsd --version ${FREEBSD_VERSION} --arch aarch64 --branch RELEASE --sysroot ${SYSROOT} --system base.txz
RUN /opt/pkg/pkgdownload.py --ignore-ca --os freebsd --version ${FREEBSD_VERSION} --arch aarch64 --branch latest --sysroot ${SYSROOT} libxml2

# Remove the "bin" directories. (1) saves space; (2) clang looks to the system instead
RUN for D in bin boot dev media mnt net proc rescue root sbin sys tmp var; do \
      rm -rf "${SYSROOT}/$D"; \
      rm -rf "${SYSROOT}/usr/$D"; \
    done

RUN mkdir -p /source && mkdir -p /build
WORKDIR /build
CMD [ "bash" ]

