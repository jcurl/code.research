    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug libsjson_test",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build (Debug)",
            "program": "${workspaceRoot}/qnx/build/local/tools/sdd/libsjson/test/libsjson_test",
            "args": [
                "--gtest_filter=sjson_reader.iterate_every_token"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/qnx/build/local/tools/sdd/libsjson/test",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable skipping built-in libraries when single stepping code",
                    "text": "-interpreter-exec console \"skip -rfu ^(std::|stdext::|testing::)\"",
                    "ignoreFailures": true
                }
            ],
        },
        {
            "name": "Debug sdd",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build (Debug)",
            "program": "${workspaceRoot}/qnx/build/local/tools/sdd/sdd",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/qnx/build/local/tools/sdd",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable skipping built-in libraries when single stepping code",
                    "text": "-interpreter-exec console \"skip -rfu ^(std::|stdext::|testing::)\"",
                    "ignoreFailures": true
                }
            ],
        },
        {
            "name": "Debug libunet_test",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build (Debug)",
            "program": "${workspaceRoot}/qnx/build/local/lib/libunet/test/libunet_test",
            "args": [ "--gtest_filter=ubench_net_udp.send_unicast" ],
