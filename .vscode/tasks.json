{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean",
            "type": "shell",
            "options": {
                "env": {
                    "VSCODE_WORKSPACE": "${workspaceFolder}/qnx"
                }
            },
            "linux": {
                "command": "${workspaceFolder}/qnx/scripts/build_local.sh clean"
            },
            "problemMatcher": []
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "options": {
                "env": {
                    "CC": "clang",
                    "CXX": "clang++",
                    "CXX_FLAGS": "-O0 -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer",
                    "VSCODE_WORKSPACE": "${workspaceFolder}/qnx"
                }
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}/qnx"
                },
                "command": "${workspaceFolder}/qnx/scripts/build_local.sh incremental"
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "fileLocation": ["absolute"],
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
